{
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/story/:id/",
      "destination": "/story/:id",
      "permanent": true
    },
    {
      "source": "/:page(about|methodology|masthead|corrections)/",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/story/a9f3ddd2243a",
      "destination": "/story/797faed5a836",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/site.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/story-:id.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/:name(og-cover|favicon|favicon-32|apple-touch-icon|icon-192|icon-512)\\.(png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
