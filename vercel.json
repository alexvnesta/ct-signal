{
  "framework": null,
  "redirects": [
    {
      "source": "/story/:id/",
      "destination": "/story/:id",
      "permanent": true
    },
    {
      "source": "/:page(about|corrections|masthead|methodology|sources)/",
      "destination": "/:page.html",
      "permanent": true
    },
    {
      "source": "/:page(about|corrections|masthead|methodology|sources)",
      "destination": "/:page.html",
      "permanent": true
    },
    {
      "source": "/story/a9f3ddd2243a",
      "destination": "/story/797faed5a836",
      "permanent": true
    },
    {
      "source": "/topic/:t/",
      "destination": "/topic/:t",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/site.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/story-:id.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/:name(og-cover|favicon|icon-192|icon-512|icon-maskable-512|favicon-32|apple-touch-icon)\\.(png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; font-src 'self'; connect-src 'self' https://cdn.jsdelivr.net; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/story/:id/embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; font-src 'self'; connect-src 'self' https://cdn.jsdelivr.net; base-uri 'self'; frame-ancestors *"
        }
      ]
    }
  ]
}
